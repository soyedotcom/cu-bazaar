generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orders        Order[]

  isSeller      Boolean        @default(false)
  sellerProfile SellerProfile?

  createdAt DateTime @default(now())
}

model SellerProfile {
  userId      String     @unique
  user        User    @relation(fields: [userId], references: [id])
  shopName    String
  description String?
  logo        String?

  products Product[]
  orders   OrderItem[]

  createdAt DateTime @default(now())
}

model Product {
  id          String @id @default(uuid())
  name        String
  image       String
  description String
  price       Float

  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [userId])

  measurements     String?
  materialsAndCare String?

  category    String
  subcategory String
  section     String

  features String[] @default([])
  tags     String[] @default([])
  variants Json?

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id     String @id @default(uuid())
  userId String

  user User @relation(fields: [userId], references: [id])

  status String @default("pending")

  items OrderItem[]

  createdAt DateTime @default(now())
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId   String
  productId String
  sellerId  String

  quantity Int
  price    Float

  status String @default("processing")

  order   Order         @relation(fields: [orderId], references: [id])
  product Product       @relation(fields: [productId], references: [id])
  seller  SellerProfile @relation(fields: [sellerId], references: [userId])
}

model CartItem {
  id Int @id @default(autoincrement())

  userId    String
  productId String

  quantity Int @default(1)

  selectedSize  String?
  selectedColor String?

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, productId, selectedSize, selectedColor])
}

model WishlistItem {
  id        String @id @default(uuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}