generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  hall     String
  room     String
  password String
  avatar   String? @default("https://res.cloudinary.com/cu-bazaar/image/upload/v1781093595/cu-bazaar/bzssy0qrmceglsj6fyry.jpg")

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orders        Order[]

  role UserRole @default(USER)

  isSeller      Boolean        @default(false)
  sellerProfile SellerProfile?

  createdAt DateTime @default(now())
}

model SellerProfile {
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shopName    String  @unique
  description String?
  logo        String?
  banner      String?

  products Product[]
  orders   OrderItem[]

  availableBalance Decimal @default(0) @db.Decimal(10, 2)
  pendingBalance   Decimal @default(0) @db.Decimal(10, 2)

  bank          String?
  accountNumber String?
  accountName   String?

  createdAt          DateTime            @default(now())
  walletTransactions WalletTransaction[]
  withdrawals        Withdrawal[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  image       String
  images      String[] @default([])
  description String
  price       Decimal  @db.Decimal(10, 2)
  rating      Int?
  stock       Int      @default(0)
  published   Boolean  @default(false)

  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [userId], onDelete: Cascade)

  measurements     String?
  materialsAndCare String?

  category    String
  subcategory String
  section     String

  features String[] @default([])
  tags     String[] @default([])
  variants Json?

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([category])
  @@index([subcategory])
  @@index([section])
}

model Order {
  id     String @id @default(uuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status DeliveryStatus @default(PENDING)

  items OrderItem[]

  totalAmount Decimal @db.Decimal(10, 2)

  paymentReference String? @unique

  paymentStatus PaymentStatus @default(PENDING)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentReference])
  @@index([paymentStatus])
  @@index([status])
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId   String
  productId String
  sellerId  String

  quantity Int
  price    Decimal @db.Decimal(10, 2)

  sellerAmount Decimal @db.Decimal(10, 2)

  platformFee Decimal @db.Decimal(10, 2)

  selectedSize  String?
  selectedColor String?

  buyerConfirmed  Boolean @default(false)
  sellerConfirmed Boolean @default(false)

  paymentStatus PaymentStatus  @default(PENDING)
  status        DeliveryStatus @default(PENDING)

  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller  SellerProfile @relation(fields: [sellerId], references: [userId], onDelete: Cascade)

  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sellerId])
  @@index([status])
}

model CartItem {
  id Int @id @default(autoincrement())

  userId    String
  productId String
  quantity  Int           @default(1)
  status    ProductStatus @default(IN_CART)

  selectedSize  String?
  selectedColor String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId, selectedSize, selectedColor])
}

model WishlistItem {
  id        String        @id @default(uuid())
  userId    String
  productId String
  status    ProductStatus @default(WISHLISTED)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Withdrawal {
  id String @id @default(uuid())

  sellerId String

  seller SellerProfile @relation(fields: [sellerId], references: [userId], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)

  status WithdrawalStatus @default(PENDING)

  reference String?

  bankName      String
  accountNumber String
  accountName   String

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([reference])
}

model WalletTransaction {
  id String @id @default(uuid())

  sellerId String

  seller SellerProfile @relation(fields: [sellerId], references: [userId], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)

  type WalletTransactionType

  description String

  reference String?

  createdAt DateTime @default(now())

  @@index([sellerId])
}

enum UserRole {
  USER
  SELLER
  ADMIN
}

enum DeliveryStatus {
  PENDING
  ACKNOWLEDGED_BY_SELLER
  DELIVERED
  CANCELLED
}

enum ProductStatus {
  WISHLISTED
  IN_CART
  PURCHASED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum WalletTransactionType {
  CREDIT_PENDING
  RELEASE_FUNDS
  WITHDRAWAL
  REFUND
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}
